{
  "name": "division-ds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "division-ds": "scripts/division-ds.mjs"
  },
  "scripts": {
    "ds": "node scripts/division-ds.mjs",
    "prepare": "npm run -s tokens:build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tokens:ramps": "node scripts/generate-ramps.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens": "npm run tokens:build && node scripts/check-contrast.mjs",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "check:button-spacing": "node scripts/check-button-spacing.mjs",
    "check:chunks": "node scripts/check-chunks.mjs",
    "check:token-discipline": "node scripts/check-token-discipline.mjs",
    "agent-docs": "node scripts/build-agent-docs.mjs",
    "check:agent-docs": "node scripts/build-agent-docs.mjs --check",
    "registry": "node scripts/build-registry.mjs",
    "check:registry": "node scripts/build-registry.mjs --check",
    "check:figma": "node scripts/check-figma-sync.mjs",
    "gates": "npm run tokens && npm run check:vocabulary && npm run check:button-spacing && npm run check:token-discipline && npm run check:agent-docs",
    "check:tokens": "node scripts/build-tokens.mjs --check && node scripts/check-contrast.mjs",
    "verify": "npm run -s check:tokens && npm run -s check:vocabulary && npm run -s check:button-spacing && npm run -s check:token-discipline && npm run -s check:agent-docs && npm run -s check:registry && npm run -s check:figma && tsc -p tsconfig.app.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit --incremental false && vitest run",
    "prebuild": "npm run gates",
    "postbuild": "npm run check:chunks",
    "test:e2e": "playwright test",
    "checkpoint:shots": "node scripts/checkpoint-shots.mjs",
    "hero:poster": "node scripts/hero-poster.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
